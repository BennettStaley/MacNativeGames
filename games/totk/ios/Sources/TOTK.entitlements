<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The game reports a 3.2 GiB application pool; the default iOS footprint limit is lower. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- A larger address space: fixed-address reservations failed with KERN_INVALID_ADDRESS without it (upstream issue
	     #99); nxnative reports about 6 GB available with it against 3.4 GB. The provisioning profile must grant it
	     ("Extended Virtual Address Space" on the App ID; paid developer accounts). power.m logs whether it is present. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
